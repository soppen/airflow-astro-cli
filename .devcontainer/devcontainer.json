{
	"name": "Python with ClickHouse",
	"dockerComposeFile": "compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/test-polars",
  	"features": {
    	"ghcr.io/devcontainers-extra/features/uv":{},
		//"ghcr.io/astronomer/devcontainer-features/astro-cli:1": {}
		"ghcr.io/devcontainers/features/docker-in-docker:1": {
        	"version": "latest"
    	}
	},
	"overrideCommand": false,
	"shutdownAction": "stopCompose",
	"forwardPorts": [8123, 9000],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.black-formatter"
			]
		}
	},
	"remoteEnv": {
		"UV_LINK_MODE": "copy"
	}
}
